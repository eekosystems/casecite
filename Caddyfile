# Caddyfile - Automatic HTTPS reverse proxy
# The site address comes from DOMAIN in .env (docker-compose.prod.yml passes it in)

{$DOMAIN:localhost} {
    # Cap request bodies at 104857600 bytes — the same limit as
    # nginx.unified.conf client_max_body_size 100M and the backend's
    # max_upload_size (100 * 1024 * 1024). Caddy reads "100MB" as 10^8 bytes,
    # which is 4.8 MB short of that; MiB is the binary unit.
    request_body {
        max_size 100MiB
    }

    # API proxy to backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Health check endpoint
    handle /health {
        reverse_proxy backend:8000
    }

    # Ready check endpoint
    handle /ready {
        reverse_proxy backend:8000
    }

    # Metrics endpoint
    handle /metrics {
        reverse_proxy backend:8000
    }

    # Word add-in task pane (static files copied from the image with the SPA).
    handle /addin/* {
        root * /srv
        try_files {path} {path}/ /addin/index.html
        file_server
    }

    # SPA: serve the built frontend, falling back to index.html for client-side
    # routes (e.g. /drafting) so deep links and refreshes don't 404.
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    # Enable compression
    encode gzip zstd

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Mirrors the backend CSP (middleware/security.py): Google Sign-In +
        # Picker (loaded only when the Google picker opens), Dropbox Chooser and
        # Box picker scripts; Microsoft Graph + the OneDrive/SharePoint picker
        # form post. Fonts are bundled, so no font CDN.
        Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com https://apis.google.com https://www.dropbox.com https://cdn01.boxcdn.net; style-src 'self' 'unsafe-inline' https://accounts.google.com https://cdn01.boxcdn.net; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://login.microsoftonline.com https://graph.microsoft.com https://accounts.google.com https://apis.google.com https://www.googleapis.com https://api.box.com https://upload.box.com; frame-src 'self' blob: https://accounts.google.com https://docs.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://onedrive.live.com https://*.sharepoint.com"
        -Server
    }

    # Logs
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
